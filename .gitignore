# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Folders
build/
.idea/
.gradle/
.settings/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Allow Gradle wrapper JAR (any depth, e.g. backend/gradle/wrapper)
!**/gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.properties

# Secrets / local config (never commit)
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
*.jks
**/application-local.*
**/application-secret.*

# Node / frontend
node_modules/
frontend/dist/

# Claude Code: personal settings and hook state
.claude/settings.local.json
.claude/.stop-checks-ok
